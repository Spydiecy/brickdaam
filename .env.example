# Copy to .env and adjust. Read by ecosystem.config.cjs (PM2). All values are optional.

# Set to 1 when the site is published through Cloudflare (Tunnel or proxied DNS), so rate limits
# use the visitor's real IP from the CF-Connecting-IP header. Leave unset otherwise.
TRUST_CLOUDFLARE=1

# Browser: "chromium" = Playwright's bundled build (default on Linux ARM), "chrome" = installed
# Google Chrome (default on macOS).
# BROWSER_CHANNEL=chromium

# Most pincodes tracked at once, and how long an unopened pincode keeps being crawled.
# MAX_PINCODES=40
# ACTIVE_DAYS=7

# Crawl schedules. Quick-commerce stores every 5 min; heavy stores are checked every 10 min
# and re-crawl each pincode once their own interval (15-30 min) has passed.
# SCRAPE_CRON=*/5 * * * *
# SLOW_SCRAPE_CRON=*/10 * * * *

# Crawls at once for scheduled runs, and for "Fetch live rates" (every store in parallel).
# On a 2-CPU / 12 GB server, 2 and 8 are fine. Lower LIVE_CONCURRENCY if memory runs short.
# SCRAPE_CONCURRENCY=2
# LIVE_CONCURRENCY=8

# Stores that block cloud-server addresses (AWS etc.). Both are free; both are optional on a home connection.
# Flipkart: local SOCKS5 proxy through Cloudflare WARP, installed by deploy/warp.sh.
# FLIPKART_PROXY=socks5://127.0.0.1:1080
# Blinkit: a free Cloudflare Worker that forwards the search calls (deploy/blinkit-worker.js).
# Put the same random key in the Worker's code and here. Never commit the real key.
# BLINKIT_WORKER_URL=https://your-worker.your-name.workers.dev/
# BLINKIT_WORKER_KEY=

# Where data lives (defaults: ./data/lego.db and ./data/img/).
# DB_PATH=/home/ubuntu/lego-tracker/data/lego.db
# IMG_DIR=/home/ubuntu/lego-tracker/data/img/
